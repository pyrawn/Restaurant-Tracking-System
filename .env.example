POSTGRES_DB=restaurant_tracker
POSTGRES_USER=restaurant
POSTGRES_PASSWORD=restaurant_dev
DATABASE_URL=postgresql://restaurant:restaurant_dev@db:5432/restaurant_tracker
PORT=8000
INPUT_DIR=/app/data/inbox
PROCESSED_DIR=/app/data/processed
MODEL_PATH=/app/models/model.pt
CONFIDENCE_THRESHOLD=0.25
FRAME_INTERVAL_SECONDS=30
DASHBOARD_REFRESH_SECONDS=30
STALE_AFTER_SECONDS=90
# LIVE_FRAME_COUNT=1 keeps each continuous cycle short (~30-40s) so the
# dashboard's 30s poll sees fresh data. The one-off confirmation test
# overrides this to 5, e.g.: docker compose run --rm -e LIVE_MODE=once
# -e LIVE_FRAME_COUNT=5 live
LIVE_STREAM_URL=https://www.youtube.com/live/2wqpy036z24
LIVE_MODE=loop
LIVE_FRAME_COUNT=1
LIVE_CAPTURE_INTERVAL_SECONDS=30
LIVE_POLL_INTERVAL_SECONDS=30
